#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#include "keys_es_latin_america.h"

&lt {
  flavor = "balanced";
  quick-tap-ms = <200>;
  tapping-term-ms = <200>;
};

/ {
  chosen {
    zmk,physical-layout = &foostan_corne_5col_layout;
  };
};

/ {
  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      quick-tap-ms = <200>;
      tapping-term-ms = <200>;
      flavor = "balanced";
      bindings = <&kp>, <&kp>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default { // 0
      label = "base";
      bindings = <
        &kp Q      &kp W      &kp E      &kp R       &kp T       &kp Y     &kp U       &kp I        &kp O           &kp P
        &hm LGUI A &hm LALT S &hm LCTL D &hm LSHFT F &lt 2 G     &lt 2 H   &hm LSHFT J &hm LCTL K   &hm LALT L      &hm LGUI ES_N_TILDE
        &kp Z      &hm RALT X &kp C      &kp V       &kp B       &kp N     &kp M       &kp ES_COMMA &hm RALT ES_DOT &kp ES_MINUS
                              &kp ESC    &lt 1 TAB   &kp SPACE   &kp RET   &lt 1 BSPC  &kp DEL
      >;
    };

    code { // 1
      label = "code";
      bindings = <
        &kp ES_PLUS &kp ES_MINUS &kp ES_STAR     &kp ES_FSLH &kp ES_PRCNT   &kp ES_AT   &kp ES_AMPS &kp ES_PIPE &kp ES_CARET &kp ES_TILDE
        &lt 3 N1    &kp N2       &kp N3          &kp N4      &kp N5         &kp N6      &kp N7      &kp N8      &kp N9       &kp N0
        &kp ES_LT   &kp ES_LBKT  &kp ES_LBRC     &kp ES_LPAR &kp ES_EQUAL   &kp ES_HASH &kp ES_RPAR &kp ES_RBRC &kp ES_RBKT  &kp ES_GT
                                 &lt 4 ES_DOLLAR &trans      &kp LSHFT      &none       &trans      &lt 4 ES_DEG
      >;
    };

    text { // 2
      label = "text";
      bindings = <
        &kp ES_IEXCL &kp ES_IQMARK &kp ES_EXCL &kp ES_QMARK &kp ES_BSLH     &none    &none    &none  &none     &none
        &kp ES_ACUTE &kp ES_GRAVE  &kp ES_SQT  &kp ES_DQT   &kp ES_UMLAUT   &kp LEFT &kp DOWN &kp UP &kp RIGHT &none
        &kp ES_LT    &kp ES_DOLLAR &kp ES_HASH &kp ES_EQUAL &kp ES_GT       &none    &none    &none  &none     &trans
                                   &none       &none        &none           &none    &none    &none
      >;
    };

    navigation { // 3
      label = "nav";
      bindings = <
        &none  &mkp MB4       &mmv MOVE_UP   &mkp MB5        &msc SCRL_UP     &none    &none    &none  &none     &none
        &none  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mkp MCLK        &kp LEFT &kp DOWN &kp UP &kp RIGHT &none
        &none  &msc SCRL_LEFT &none          &msc SCRL_RIGHT &msc SCRL_DOWN   &none    &none    &none  &none     &none
                              &none          &mkp RCLK       &mkp LCLK        &none    &none    &none
      >;
    };

    config { // 4
      label = "config";
      bindings = <
        &kp F12 &kp F7 &kp F8 &kp F9 &none        &none        &none        &none        &none        &none
        &kp F11 &kp F4 &kp F5 &kp F6 &none        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
        &kp F10 &kp F1 &kp F2 &kp F3 &none        &none        &none        &none        &none        &none
                       &trans &none  &bt BT_CLR   &none        &none        &trans
      >;
    };
  };
};

    /* template { */
    /*   bindings = < */
    /*     &none &none &none &none &none             &none &none &none &none &none */
    /*     &none &none &none &none &none             &none &none &none &none &none */
    /*     &none &none &none &none &none             &none &none &none &none &none */
    /*                       &none &none &none &none &none &none */
    /*   >; */
    /* }; */
